      "direction": "rtl",
      "text": "الاعتصام هنا جمع للقلوب على الخير وترك الفرقة."
    },
    {
      "id": "cap_u03",
      "startSec": 3.637,
      "endSec": 4.352,
      "direction": "rtl",
      "text": "كيف نطبق ذلك في بيوتنا؟"
