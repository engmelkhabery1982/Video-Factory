      "endSec": 5.848,
      "direction": "ltr",
      "text": "Many sites lose a day when a crane waits for a delivery nobody confirmed."
    },
    {
      "id": "cap_u02",
      "startSec": 5.848,
      "endSec": 10.859,
      "direction": "ltr",
      "text": "For example, a concrete pour was booked for seven but the truck arrived at nine."
    },
    {
      "id": "cap_u03",
      "startSec": 10.859,
      "endSec": 14.787,
      "direction": "ltr",
      "text": "Check the delivery window the night before and confirm it with the supplier."
    },
    {
      "id": "cap_u04",
      "startSec": 14.787,
      "endSec": 18.977,
      "direction": "ltr",
      "text": "Write the confirmed time on the site board so every crew sees it."
    }
  ]
