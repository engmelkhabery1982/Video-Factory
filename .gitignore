# dependencies
node_modules/

# build output
apps/web/dist/
packages/core/dist/
*.tsbuildinfo

# locally provisioned renderer (rebuilt by `npm run provision`)
.browser/

# Remotion bundler cache and render scratch space
.remotion/

# locally provisioned production TTS model cache (rebuilt by `npm run provision:tts`)
.tts-cache/
.remotion-probe/
.stills/
.tmp-probe/
.test-phase6b/
.test-phase6c/
.bench.mp4
.test-render.mp4
*.log

# the user's own work: projects, uploads, voiceovers and rendered videos.
# These are deliberately NOT committed - they are produced by running the app
# and can be hundreds of megabytes. The demo deliverables live in output/ and
# are also ignored; see REVIEW_HANDOFF.md for where to find them.
data/
output/

# editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.test-phase6d/

# Phase 6E full-production evidence scratch (regenerated by the test run)
.test-phase6e/
