+      plan.clips.forEach(clip => {
+        expect(clip.suggestedPath).toMatch(/^audio\/dialogue\/[a-zA-Z0-9_\-]+\/[a-zA-Z0-9_\-]+\.wav$/);
+        expect(clip.suggestedPath.startsWith('/')).toBe(false);
+        expect(clip.suggestedPath.includes('..')).toBe(false);
+      });
